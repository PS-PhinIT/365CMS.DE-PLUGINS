# 365NET Events & Speaker – Vorlage für die optionale Google-CSE-Anreicherung (Speaker-Backfill)
#
# Werte bevorzugt als Server-Umgebungsvariablen setzen. Alternativ diese Datei als „.env“
# in das 365CMS-Stammverzeichnis kopieren (dort per .htaccess des Cores gesperrt).
# Eine .env im Plugin-Ordner wird weiterhin gelesen, liegt aber im Web-Root – bei Apache
# sperrt die .htaccess dieses Plugins versteckte Dateien, bei nginx selbst absichern.
# Platzhalter „__SET_…__“ gelten als nicht konfiguriert.
CMS_365NETEVENTS_GOOGLE_API_KEY=__SET_GOOGLE_API_KEY__
CMS_365NETEVENTS_GOOGLE_CSE_ID=__SET_GOOGLE_CSE_ID__
